# Never commit the real .env. Use a Groq FREE account for free inference.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Informational operator declaration: cannot detect the billing tier of a key.
API_PLAN=free
ALLOW_PAID_API=false
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
COLLECTION_NAME=gcp_docs_v2
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
MAX_CONTEXT_CHARS=12000
MAX_OUTPUT_TOKENS=1000
REQUEST_TIMEOUT=45
MAX_HISTORY_MESSAGES=6
RETRIEVAL_K=5
MIN_RELEVANCE_SCORE=0.30
CRAWL_MAX_PAGES=25
CRAWL_DELAY=1
# Native Python only; Compose overrides these with internal service addresses.
DATA_DIR=data
QDRANT_URL=http://localhost:6333
MCP_URL=http://localhost:8001/mcp
