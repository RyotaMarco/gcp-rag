    "evaluate:real": "bun scripts/evaluate-real.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261024.1",
    "@types/bun": "^1.3.0",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "^5.9.0",
    "wrangler": "4.151.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  }
}
