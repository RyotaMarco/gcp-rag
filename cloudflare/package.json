{
  "name": "gcp-copilot-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "check:deploy": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime false --env-interface GeneratedBindings --strict-vars false",
