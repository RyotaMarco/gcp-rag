# Public build configuration only. Never put the Turnstile secret or an AI key here.
# Leave these empty for the existing local Docker/FastAPI mode.
VITE_DEPLOY_TARGET=
VITE_TURNSTILE_SITE_KEY=
# Set to preview only for preview builds: blocks indexing in static asset headers/robots.
# Leave empty for production and Docker builds.
VITE_DEPLOY_ENVIRONMENT=
